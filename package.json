{
  "name": "dsh-searchops",
  "version": "0.1.0",
  "description": "Agent-native search, log investigation and cluster operations for DeepSeek Harness. OpenSearch-first, provider-neutral by design.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "check": "node --check index.js && find lib scripts -name '*.js' -exec node --check {} \\; && find test -name '*.test.js' -exec node --check {} \\;",
    "test": "node --test",
    "demo": "node scripts/demo.mjs",
    "verify": "npm run check && npm test",
    "prepack": "npm run verify"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "docs",
    "examples",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.1.1-rc.0 || ^0.1.2-alpha.0 || ^0.1.3-alpha.0 || ^0.1.5-alpha.0 || ^0.1.5-rc.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.5-rc.1"
  },
  "engines": {
    "node": ">=20.11"
  },
  "keywords": [
    "deepseek",
    "harness",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "searchops",
    "opensearch",
    "elasticsearch",
    "search",
    "logs",
    "log-analysis",
    "observability",
    "sre",
    "investigation",
    "agent",
    "ai-agent"
  ],
  "author": "guhanfei-ai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guhanfei-ai/dsh-searchops.git"
  },
  "homepage": "https://github.com/guhanfei-ai/dsh-searchops#readme",
  "bugs": {
    "url": "https://github.com/guhanfei-ai/dsh-searchops/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  }
}
